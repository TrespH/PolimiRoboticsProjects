include "my_robot.inc"

define floorplan model
(
  color "gray30"

  boundary 1

  gui_nose 1
  gui_grid 0
  gui_outline 0
  gripper_return 0
  fiducial_return 0
  laser_return 1
)

resolution 0.05
interval_sim 100

floorplan
(
  name "map"
  bitmap "../map/cropped_cleaned.png" 
  size [32.55 18.6 1.0]     
  pose [0 0 0 0]               # initial position
  origin [4.263954 -2.892354 0 0]    #size/2+origin
)

window
(
  size [ 1000 700 ]
  center [0 0 0.0]
)

my_robot
(
  pose [-6.5 -4.0 0 0]
)
